# Runtime: Supavisor transaction pooler for serverless deployments.
# Copy the exact string from Supabase Dashboard > Connect; do not construct the
# username or host manually. Append schema=trove to its query parameters.
DATABASE_URL="<exact-transaction-pooler-url-with-schema=trove>"

# Prisma CLI: Supavisor session pooler or an IPv4-compatible direct connection.
# Copy the exact string from Supabase Dashboard > Connect; this URL is never
# used by the deployed API.
DIRECT_URL="<exact-session-or-direct-url-with-schema=trove>"

# Optional: isolated local/Supabase-branch database used only by `prisma migrate dev`.
# Never point this at the shared production database.
SHADOW_DATABASE_URL="<isolated-shadow-database-url-with-schema=trove>"

# Shared Supabase project URL. The browser uses the equivalent NEXT_PUBLIC_ value
# in apps/web/.env.local. This URL is safe to expose; do not use a service-role key.
SUPABASE_URL="<supabase-project-url>"

# Publishable key from Supabase Dashboard > Connect. This is not a secret and is
# required by the API only to ask Supabase Auth to verify an incoming access token.
SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"

# Server-only Google Maps Platform keys. Restrict each key to its named API and
# the deployed API's server egress. Never expose either as a NEXT_PUBLIC_ value.
GOOGLE_PLACES_API_KEY="<server-only-google-places-api-key>"
GOOGLE_ROUTES_API_KEY="<server-only-google-routes-api-key>"

# Emergency brake. Set to 1 or true to stop every outbound Google Places and
# Routes request; the app degrades to the same "unavailable" states it shows
# when the keys are absent. Leave unset in production.
TROVE_GOOGLE_PROVIDERS_DISABLED=""

# Scoped brake for Plan Score only. Set to 1 or true to stop Plan Score's own
# Places/Routes calls (its factors fall back to unknown) without affecting
# search, place details, or day-route views elsewhere. Leave unset in production.
TROVE_PLAN_SCORE_DISABLED=""

# Comma-separated browser origins allowed to call the API.
TROVE_WEB_ORIGINS="http://localhost:3000"
