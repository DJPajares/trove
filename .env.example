# Runtime: Supavisor transaction pooler for serverless deployments.
# Copy the exact string from Supabase Dashboard > Connect; do not construct the
# username or host manually. Append schema=trove to its query parameters.
DATABASE_URL="<exact-transaction-pooler-url-with-schema=trove>"

# Prisma CLI: Supavisor session pooler or an IPv4-compatible direct connection.
# Copy the exact string from Supabase Dashboard > Connect; this URL is never
# used by the deployed API.
DIRECT_URL="<exact-session-or-direct-url-with-schema=trove>"

# Optional: isolated local/Supabase-branch database used only by `prisma migrate dev`.
# Never point this at the shared production database.
SHADOW_DATABASE_URL="<isolated-shadow-database-url-with-schema=trove>"

# Shared Supabase project URL. The browser uses the equivalent NEXT_PUBLIC_ value
# in apps/web/.env.local. This URL is safe to expose; do not use a service-role key.
SUPABASE_URL="<supabase-project-url>"

# Publishable key from Supabase Dashboard > Connect. This is not a secret and is
# required by the API only to ask Supabase Auth to verify an incoming access token.
SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"

# Server-only Google Maps Platform keys. Restrict each key to its named API and
# the deployed API's server egress. Never expose either as a NEXT_PUBLIC_ value.
GOOGLE_PLACES_API_KEY="<server-only-google-places-api-key>"
GOOGLE_ROUTES_API_KEY="<server-only-google-routes-api-key>"

# Emergency brake. Set to 1 or true to stop every outbound Google Places and
# Routes request; the app degrades to the same "unavailable" states it shows
# when the keys are absent. Leave unset in production.
TROVE_GOOGLE_PROVIDERS_DISABLED=""

# Scoped Plan Score kill switch. Set to 1 or true in both API and web server
# environments to stop scoring and hide every Plan Score surface without affecting
# search, place details, or day-route views elsewhere. Leave unset in production.
TROVE_PLAN_SCORE_DISABLED=""

# Server-only Pexels API key for Trove's editorial imagery. Editorial photos are
# decorative, free, hotlinked and always attributed - they are never Google
# Places photos. Never expose this as a NEXT_PUBLIC_ value.
PEXELS_API_KEY="<server-only-pexels-api-key>"

# Editorial imagery kill switch. Set to 1 or true to stop every outbound Pexels
# request; each surface degrades to the branded category fallback it already
# renders when no photograph exists. Leave unset in production.
TROVE_EDITORIAL_IMAGES_DISABLED=""

# Optional ceiling on outbound Pexels requests per rolling hour. Defaults to 150,
# which leaves headroom under Pexels' 200/hour limit. Lower it to throttle; the
# service degrades to the branded fallback once the ceiling is reached.
TROVE_EDITORIAL_IMAGE_HOURLY_BUDGET=""

# Server-only AI generation configuration. Local development uses Google
# Application Default Credentials when the explicit credential pair is unset.
# Never expose these values through NEXT_PUBLIC_ variables.
TROVE_AI_PROVIDER="vertex"
TROVE_AI_MODEL="gemini-3.1-flash-lite"
TROVE_AI_TIMEOUT_MS="60000"
TROVE_AI_MAX_OUTPUT_TOKENS="8192"
GOOGLE_VERTEX_PROJECT="<google-cloud-project-id>"
GOOGLE_VERTEX_LOCATION="global"
GOOGLE_VERTEX_CLIENT_EMAIL=""
GOOGLE_VERTEX_PRIVATE_KEY=""

# Emergency and budget brakes. Either value accepts 1 or true and prevents all
# AI provider construction and requests. Leave unset during normal operation.
TROVE_AI_DISABLED=""
TROVE_AI_BUDGET_DISABLED=""

# Shared secret for scheduled maintenance. Vercel Cron presents it as
# `Authorization: Bearer <value>`. Leave unset locally: the maintenance route
# stays closed rather than open when no secret is configured.
CRON_SECRET=""

# Comma-separated browser origins allowed to call the API.
TROVE_WEB_ORIGINS="http://localhost:3000"
