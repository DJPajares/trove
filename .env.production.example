# Copy to the gitignored .env.production. Never commit real credentials.
TROVE_ENVIRONMENT="production"

# Prisma migrations: Supavisor session pooler or direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=trove"

# Operational database client: Supavisor transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=trove"

# Needed only when reconciliation is invoked with --refresh --apply.
PEXELS_API_KEY="<server-only-pexels-api-key>"

# Optional; defaults to the application's existing conservative ceiling.
TROVE_EDITORIAL_IMAGE_HOURLY_BUDGET=""
