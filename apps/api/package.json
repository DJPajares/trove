{
  "name": "@trove/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@trove/config": "workspace:*",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11"
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsc --project tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "lint": "../../node_modules/.bin/oxlint --deny-warnings src test",
    "start": "node dist/server.js",
    "test": "../../node_modules/.bin/tsc --noEmit --project tsconfig.test.json && tsx --test test/*.test.ts",
    "typecheck": "../../node_modules/.bin/tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@trove/db": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "zod": "4.4.3"
  }
}
