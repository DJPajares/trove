{
  "name": "@trove/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@trove/config": "workspace:*",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12"
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsc --project tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "editorial-images:reconcile": "tsx scripts/reconcile-editorial-images.ts",
    "lint": "../../node_modules/.bin/oxlint --deny-warnings scripts src test",
    "production:operation": "tsx scripts/run-production-operation.ts",
    "start": "node dist/server.js",
    "test": "../../node_modules/.bin/tsc --noEmit --project tsconfig.test.json && ../../node_modules/.bin/vitest run",
    "typecheck": "../../node_modules/.bin/tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "@trove/db": "workspace:*",
    "countries-and-timezones": "^3.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "zod": "4.4.3"
  }
}
