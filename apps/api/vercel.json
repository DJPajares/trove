{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @trove/db build && pnpm --filter @trove/api build",
  "crons": [{ "path": "/maintenance/ai-planning-retention", "schedule": "0 3 * * *" }],
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
