# Copy to apps/web/.env.local for local Next.js development.
NEXT_PUBLIC_SUPABASE_URL="<supabase-project-url>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Server-only password-recovery receipt key: generate 32 random bytes as base64url.
# Use a separate key per environment; never prefix it NEXT_PUBLIC_.
AUTH_RECOVERY_SECRET=""

# Server-side Plan Score kill switch. Match the API environment value so Next.js
# omits Plan Score requests and UI before the browser mounts a score surface.
PLAN_SCORE_DISABLED=""

# Server-side sign-up kill switch. Set to "true" to close self-service account
# creation (e.g. while sharing a preview link before public launch) while
# leaving sign-in for already-created accounts unaffected.
SIGN_UP_DISABLED=""

# Browser-only Google Maps key. Create a separate key from the server-side
# Places key, restrict it to the app's website origins, and allow only the
# Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="<website-restricted-google-maps-api-key>"

# JavaScript vector map ID used by Advanced Markers. Create it under Google
# Maps Platform > Map Management and configure the same value in Vercel.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="<google-maps-javascript-map-id>"

# In Supabase Auth > URL Configuration, add these email-confirmation callback
# URLs to the existing allow list without removing other application URLs:
# Follow docs/auth/email-auth-rollout.md for the exact callback allow list.
