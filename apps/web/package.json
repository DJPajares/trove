{
  "name": "@trove/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "brand:check": "node scripts/generate-brand-assets.mjs --check",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "build": "pnpm brand:check && next build",
    "dev": "next dev --port 3000",
    "dev:reset": "rm -rf .next/dev/cache/turbopack",
    "lint": "../../node_modules/.bin/oxlint --deny-warnings app components i18n lib scripts test",
    "start": "next start --port 3000",
    "test": "../../node_modules/.bin/tsc --noEmit --project tsconfig.test.json && ../../node_modules/.bin/vitest run",
    "typecheck": "../../node_modules/.bin/tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "6.3.1",
