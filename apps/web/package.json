    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@trove/config": "workspace:*",
    "@types/google.maps": "3.66.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
