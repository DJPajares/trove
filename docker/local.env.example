# Local Docker PostgreSQL connection values for Prisma and the Trove API.
# Keep this file separate from the hosted Supabase values in the root .env.
DATABASE_URL="postgresql://trove:trove_dev@localhost:54329/trove?schema=trove"
DIRECT_URL="postgresql://trove:trove_dev@localhost:54329/trove?schema=trove"
SHADOW_DATABASE_URL="postgresql://trove:trove_dev@localhost:54329/trove_shadow?schema=trove"

# Optional: use a different host port when 54329 is already occupied.
TROVE_POSTGRES_PORT="54329"
