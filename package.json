{
  "name": "trove",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "predev": "pnpm --filter @trove/db build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @trove/db db:generate",
    "db:migrate": "pnpm --filter @trove/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @trove/db db:migrate:deploy",
    "db:seed": "pnpm --filter @trove/db db:seed",
    "db:validate-env": "pnpm --filter @trove/db db:validate-env"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
