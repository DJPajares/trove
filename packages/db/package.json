{
  "name": "@trove/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@trove/config": "workspace:*",
    "@types/pg": "^8.21.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12"
  },
  "scripts": {
    "build": "pnpm db:generate && ../../node_modules/.bin/tsc --project tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:validate-env": "tsx src/validate-environment.ts",
    "lint": "../../node_modules/.bin/oxlint --deny-warnings prisma/seed.ts src",
    "typecheck": "pnpm db:generate && ../../node_modules/.bin/tsc --noEmit --project tsconfig.json",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
