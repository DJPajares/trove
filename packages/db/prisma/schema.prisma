  @@schema("trove")
}

enum ExpenseTimeZoneSource {
  ITINERARY_ITEM @map("itinerary_item")
  TRIP_PLACE     @map("trip_place")
  ITINERARY_DAY  @map("itinerary_day")
  TRIP_REFERENCE @map("trip_reference")

  @@map("expense_time_zone_source")
  @@schema("trove")
}

enum TripPlacePriority {
  MUST_GO    @map("must_go")
