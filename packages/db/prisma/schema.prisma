  @@map("itinerary_time_semantics")
  @@schema("trove")
}

enum ItineraryTravelStatus {
  UPCOMING  @map("upcoming")
  COMPLETED @map("completed")
  SKIPPED   @map("skipped")

  @@map("itinerary_travel_status")
  @@schema("trove")
}

enum ItineraryDurationProvenance {
  USER_OWNED   @map("user_owned")
