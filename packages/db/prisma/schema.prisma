  @@map("ai_planning_session_status")
  @@schema("trove")
}

enum AiPlanningSessionStage {
  CREATED    @map("created")
  GENERATING @map("generating")
  GROUNDING  @map("grounding")
  SCHEDULING @map("scheduling")
  VALIDATING @map("validating")
  REVIEWING  @map("reviewing")
  APPLYING   @map("applying")
  COMPLETE   @map("complete")

  @@map("ai_planning_session_stage")
  @@schema("trove")
}

enum AiGenerationRunResult {
  PENDING   @map("pending")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("ai_generation_run_result")
  @@schema("trove")
}

enum RouteTravelMode {
  DRIVE   @map("drive")
  FLIGHT  @map("flight")
  TRANSIT @map("transit")
  WALK    @map("walk")

  @@map("route_travel_mode")
  @@schema("trove")
}

enum TaskTimeZoneSource {
  ITINERARY_ITEM @map("itinerary_item")
  ITINERARY_DAY  @map("itinerary_day")
  TRIP_REFERENCE @map("trip_reference")

  @@map("task_time_zone_source")
  @@schema("trove")
}

enum ProfileDistanceUnit {
  KILOMETERS @map("km")
  MILES      @map("mi")

  @@map("profile_distance_unit")
  @@schema("trove")
}

enum ProfileTemperatureUnit {
  CELSIUS    @map("celsius")
  FAHRENHEIT @map("fahrenheit")

  @@map("profile_temperature_unit")
  @@schema("trove")
}

enum ProfileTimeFormat {
  HOUR_12 @map("12h")
  HOUR_24 @map("24h")

  @@map("profile_time_format")
  @@schema("trove")
}

enum ProfileDateFormat {
  MONTH_DAY_YEAR @map("mdy")
  DAY_MONTH_YEAR @map("dmy")
  YEAR_MONTH_DAY @map("ymd")

  @@map("profile_date_format")
  @@schema("trove")
