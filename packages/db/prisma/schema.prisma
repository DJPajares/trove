  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, path])
  @@index([reservationId])
  @@map("reservation_attachments")
  @@schema("trove")
}

model ReservationAccommodationDay {
  reservationId  String   @map("reservation_id") @db.Uuid
  itineraryDayId String   @map("itinerary_day_id") @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation  Reservation  @relation(fields: [reservationId, tripId], references: [id, tripId], onDelete: Cascade)
  itineraryDay ItineraryDay @relation(fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: Cascade)

  @@id([reservationId, itineraryDayId])
  @@index([itineraryDayId, tripId])
  @@map("reservation_accommodation_days")
  @@schema("trove")
}

model Expense {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  tripId             String                 @map("trip_id") @db.Uuid
  itineraryDayId     String?                @map("itinerary_day_id") @db.Uuid
  itineraryItemId    String?                @map("itinerary_item_id") @db.Uuid
  tripPlaceId        String?                @map("trip_place_id") @db.Uuid
  amount             Decimal                @db.Decimal(12, 2)
  currencyCode       String                 @map("currency_code") @db.Char(3)
  title              String?
  category           ExpenseCategory?
  localDate          DateTime?              @map("local_date") @db.Date
  localTime          DateTime?              @map("local_time") @db.Time(0)
  timeZone           String?                @map("time_zone")
  timeZoneSource     ExpenseTimeZoneSource? @map("time_zone_source")
  timeZoneResolvedAt DateTime?              @map("time_zone_resolved_at") @db.Timestamptz(3)
  note               String?                @db.Text
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryDay  ItineraryDay?  @relation("ExpenseItineraryDay", fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: NoAction)
  itineraryItem ItineraryItem? @relation("ExpenseItineraryItem", fields: [itineraryItemId, tripId], references: [id, tripId], onDelete: NoAction)
  tripPlace     TripPlace?     @relation(fields: [tripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)

  @@unique([id, tripId])
  @@index([tripId, localDate])
  @@index([itineraryDayId, tripId])
  @@index([itineraryItemId, tripId])
  @@index([tripPlaceId, tripId])
  @@map("expenses")
  @@schema("trove")
}

model Memory {
  id                 String               @id @default(uuid(7)) @db.Uuid
  tripId             String               @map("trip_id") @db.Uuid
  itineraryDayId     String?              @map("itinerary_day_id") @db.Uuid
  itineraryItemId    String?              @map("itinerary_item_id") @db.Uuid
  tripPlaceId        String?              @map("trip_place_id") @db.Uuid
  note               String?              @db.Text
  isHighlight        Boolean              @default(false) @map("is_highlight")
  highlightPosition  Int?                 @map("highlight_position")
  capturedInstant    DateTime             @map("captured_instant") @db.Timestamptz(3)
  capturedLocalDate  DateTime             @map("captured_local_date") @db.Date
  capturedLocalTime  DateTime             @map("captured_local_time") @db.Time(0)
  timeZone           String               @map("time_zone")
  timeZoneSource     MemoryTimeZoneSource @map("time_zone_source")
  timeZoneResolvedAt DateTime             @default(now()) @map("time_zone_resolved_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryDay  ItineraryDay?  @relation(fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: NoAction)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId, tripId], references: [id, tripId], onDelete: NoAction)
  tripPlace     TripPlace?     @relation(fields: [tripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)
  photos        MemoryPhoto[]

  @@unique([id, tripId])
  @@index([tripId, capturedInstant])
  @@index([tripId, isHighlight, highlightPosition])
  @@index([itineraryDayId, tripId])
  @@index([itineraryItemId, tripId])
  @@index([tripPlaceId, tripId])
  @@map("memories")
  @@schema("trove")
}

model MemoryPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  memoryId    String   @map("memory_id") @db.Uuid
  path        String
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memory             Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  storyCoverForTrips Trip[] @relation("TripStoryCoverPhoto")

  @@unique([memoryId, path])
  @@index([memoryId, position])
  @@map("memory_photos")
  @@schema("trove")
}
