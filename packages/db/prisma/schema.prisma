model AiPlanningSession {
  id                           String                  @id @default(uuid(7)) @db.Uuid
  ownerId                      String                  @map("owner_id") @db.Uuid
  status                       AiPlanningSessionStatus @default(PENDING)
  stage                        AiPlanningSessionStage  @default(CREATED)
  rawPrompt                    String?                 @map("raw_prompt") @db.Text
  /// Traveller-supplied trip description, carried to Trip.description on apply.
  /// Session metadata rather than part of the plan, so it never touches the
  /// immutable draft JSON and never moves draftRevision.
  tripDescription              String?                 @map("trip_description") @db.Text
  /// Traveller-supplied trip name, carried to Trip.name on apply. Session
  /// metadata rather than part of the plan, so it never touches the immutable
  /// draft JSON and never moves draftRevision.
  tripName                     String?                 @map("trip_name") @db.Text
  draft                        Json?                   @db.JsonB
  /// Plan Score for the draft, computed during generation from the evidence
  /// that run already fetched. Derived rather than part of the plan, so it
  /// sits beside the draft and is rewritten with it on every successful run.
  planScore                    Json?                   @map("plan_score") @db.JsonB
  schemaVersion                Int                     @default(1) @map("schema_version")
  draftRevision                Int                     @default(0) @map("draft_revision")
  warningsAcknowledgedRevision Int?                    @map("warnings_acknowledged_revision")
  warningsAcknowledgedAt       DateTime?               @map("warnings_acknowledged_at") @db.Timestamptz(3)
  lastErrorCode                String?                 @map("last_error_code") @db.VarChar(120)
  expiresAt                    DateTime                @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)")) @map("expires_at") @db.Timestamptz(3)
  appliedTripId                String?                 @unique @map("applied_trip_id") @db.Uuid
  createdAt                    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner       Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appliedTrip Trip?             @relation("AiPlanningAppliedTrip", fields: [appliedTripId], references: [id], onDelete: SetNull)
  runs        AiGenerationRun[]

  @@unique([id, ownerId])
  @@index([ownerId, status, updatedAt])
  @@index([status, expiresAt])
  @@map("ai_planning_sessions")
  @@schema("trove")
}

model AiGenerationRun {
  id                String                @id @default(uuid(7)) @db.Uuid
  sessionId         String                @map("session_id") @db.Uuid
  ownerId           String                @map("owner_id") @db.Uuid
  idempotencyKey    String                @map("idempotency_key") @db.Uuid
  baseDraftRevision Int                   @default(0) @map("base_draft_revision")
  provider          String                @db.VarChar(120)
  model             String                @db.VarChar(120)
  inputTokens       Int?                  @map("input_tokens")
  outputTokens      Int?                  @map("output_tokens")
  totalTokens       Int?                  @map("total_tokens")
  latencyMs         Int?                  @map("latency_ms")
  result            AiGenerationRunResult @default(PENDING)
  errorCode         String?               @map("error_code") @db.VarChar(120)
  dispatchedAt      DateTime?             @map("dispatched_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  session AiPlanningSession @relation(fields: [sessionId, ownerId], references: [id, ownerId], onDelete: Cascade)
  owner   Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, dispatchedAt])
  @@index([ownerId, createdAt])
  @@index([sessionId, createdAt])
  @@index([sessionId, ownerId])
  @@index([createdAt])
  @@map("ai_generation_runs")
  @@schema("trove")
}

