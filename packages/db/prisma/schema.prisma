generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "trove"]
}

enum PlaceKind {
  PROVIDER @map("provider")
  CUSTOM   @map("custom")

  @@map("place_kind")
  @@schema("trove")
}

enum PlaceProvider {
  GOOGLE @map("google")

  @@map("place_provider")
  @@schema("trove")
}

enum TripPlanningReadiness {
  IN_PROGRESS @map("in_progress")
  READY       @map("ready")

  @@map("trip_planning_readiness")
  @@schema("trove")
}

enum TripVisibility {
  PRIVATE @map("private")
  SHARED  @map("shared")
  PUBLIC  @map("public")

  @@map("trip_visibility")
  @@schema("trove")
}

enum TripUserRole {
  OWNER        @map("owner")
  COLLABORATOR @map("collaborator")
  VIEWER       @map("viewer")

  @@map("trip_user_role")
  @@schema("trove")
}

enum TripTimeZoneSource {
  EXPLICIT          @map("explicit")
  DESTINATION       @map("destination")
  STARTING_LOCATION @map("starting_location")
  PROFILE_HOME      @map("profile_home")
  DEVICE_FALLBACK   @map("device_fallback")

  @@map("trip_time_zone_source")
  @@schema("trove")
}

enum DayTimeZoneSource {
  EXPLICIT_DAILY_BASE @map("explicit_daily_base")
  ACCOMMODATION       @map("accommodation")
  FIRST_LOCATED_ITEM  @map("first_located_item")
  TRIP_REFERENCE      @map("trip_reference")

  @@map("day_time_zone_source")
  @@schema("trove")
}

enum ItemTimeZoneSource {
  EXPLICIT    @map("explicit")
  PLACE       @map("place")
  DAY_DEFAULT @map("day_default")

  @@map("item_time_zone_source")
  @@schema("trove")
}

enum ReservationType {
  FLIGHT        @map("flight")
  ACCOMMODATION @map("accommodation")
  RESTAURANT    @map("restaurant")
  ATTRACTION    @map("attraction")
  TRAIN         @map("train")
  RENTAL_CAR    @map("rental_car")
  FERRY         @map("ferry")
  BUS           @map("bus")
  TOUR          @map("tour")
  OTHER         @map("other")

  @@map("reservation_type")
  @@schema("trove")
}

enum MemoryTimeZoneSource {
  ITINERARY_ITEM @map("itinerary_item")
  TRIP_PLACE     @map("trip_place")
  ITINERARY_DAY  @map("itinerary_day")
  TRIP_REFERENCE @map("trip_reference")

  @@map("memory_time_zone_source")
  @@schema("trove")
}

enum ReservationTimeZoneSource {
  TRIP_PLACE     @map("trip_place")
  ITINERARY_ITEM @map("itinerary_item")
  TRIP_REFERENCE @map("trip_reference")

  @@map("reservation_time_zone_source")
  @@schema("trove")
}

enum ExpenseCategory {
  FOOD       @map("food")
  TRANSPORT  @map("transport")
  STAY       @map("stay")
  ACTIVITIES @map("activities")
  SHOPPING   @map("shopping")
  OTHER      @map("other")

  @@map("expense_category")
  @@schema("trove")
}

enum ExpenseTimeZoneSource {
  ITINERARY_ITEM @map("itinerary_item")
  TRIP_PLACE     @map("trip_place")
  ITINERARY_DAY  @map("itinerary_day")
  TRIP_REFERENCE @map("trip_reference")

  @@map("expense_time_zone_source")
  @@schema("trove")
}

enum TripPlacePriority {
  MUST_GO    @map("must_go")
  INTERESTED @map("interested")
  MAYBE      @map("maybe")

  @@map("trip_place_priority")
  @@schema("trove")
}

enum ItineraryDayPart {
  MORNING   @map("morning")
  AFTERNOON @map("afternoon")
  EVENING   @map("evening")
  ANYTIME   @map("anytime")

  @@map("itinerary_day_part")
  @@schema("trove")
}

enum ItineraryTimeSemantics {
  FLOATING_LOCAL        @map("floating_local")
  AUTHORITATIVE_INSTANT @map("authoritative_instant")

  @@map("itinerary_time_semantics")
  @@schema("trove")
}

enum ItineraryTravelStatus {
  UPCOMING  @map("upcoming")
  COMPLETED @map("completed")
  SKIPPED   @map("skipped")

  @@map("itinerary_travel_status")
  @@schema("trove")
}

enum RouteTravelMode {
  DRIVE   @map("drive")
  FLIGHT  @map("flight")
  TRANSIT @map("transit")
  WALK    @map("walk")

  @@map("route_travel_mode")
  @@schema("trove")
}

enum TaskTimeZoneSource {
  ITINERARY_ITEM @map("itinerary_item")
  ITINERARY_DAY  @map("itinerary_day")
  TRIP_REFERENCE @map("trip_reference")

  @@map("task_time_zone_source")
  @@schema("trove")
}

enum ProfileDistanceUnit {
  KILOMETERS @map("km")
  MILES      @map("mi")

  @@map("profile_distance_unit")
  @@schema("trove")
}

enum ProfileTemperatureUnit {
  CELSIUS    @map("celsius")
  FAHRENHEIT @map("fahrenheit")

  @@map("profile_temperature_unit")
  @@schema("trove")
}

enum ProfileTimeFormat {
  HOUR_12 @map("12h")
  HOUR_24 @map("24h")

  @@map("profile_time_format")
  @@schema("trove")
}

enum ProfileDateFormat {
  MONTH_DAY_YEAR @map("mdy")
  DAY_MONTH_YEAR @map("dmy")
  YEAR_MONTH_DAY @map("ymd")

  @@map("profile_date_format")
  @@schema("trove")
}

enum ProfileAppearance {
  SYSTEM @map("system")
  LIGHT  @map("light")
  DARK   @map("dark")

  @@map("profile_appearance")
  @@schema("trove")
}

enum NotificationKind {
  TASK_DUE             @map("task_due")
  RESERVATION_UPCOMING @map("reservation_upcoming")
  LEAVE_BY             @map("leave_by")

  @@map("notification_kind")
  @@schema("trove")
}

/// Supabase owns this table. Prisma Client may reference its primary key, but
/// Prisma Migrate excludes it through `tables.external` in prisma.config.ts.
model AuthUser {
  id      String   @id @db.Uuid
  profile Profile?

  @@map("users")
  @@schema("auth")
}

model Profile {
  id                          String                  @id @db.Uuid
  displayName                 String?                 @map("display_name")
  avatarPath                  String?                 @map("avatar_path")
  homePlaceId                 String?                 @map("home_place_id") @db.Uuid
  homeCurrencyCode            String?                 @map("home_currency_code") @db.Char(3)
  distanceUnit                ProfileDistanceUnit?    @map("distance_unit")
  temperatureUnit             ProfileTemperatureUnit? @map("temperature_unit")
  timeFormat                  ProfileTimeFormat?      @map("time_format")
  dateFormat                  ProfileDateFormat?      @map("date_format")
  appearance                  ProfileAppearance?      @map("appearance")
  notificationsEnabled        Boolean                 @default(false) @map("notifications_enabled")
  browserNotificationsEnabled Boolean                 @default(false) @map("browser_notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  authUser                    AuthUser                     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  homePlace                   Place?                       @relation("ProfileHomePlace", fields: [homePlaceId], references: [id], onDelete: SetNull)
  ownedPlaces                 Place[]                      @relation("PlaceOwner")
  ownedTrips                  Trip[]                       @relation("TripOwner")
  createdTrips                Trip[]                       @relation("TripCreator")
  tripRelations               TripUserRelationship[]
  savedPlaces                 SavedPlace[]
  savedCollections            SavedCollection[]
  collectionPlaces            SavedCollectionPlace[]
  taskTemplates               TaskTemplate[]
  notifications               Notification[]
  tripNotificationPreferences TripNotificationPreference[]

  @@index([homePlaceId])
  @@map("profiles")
  @@schema("trove")
}

model Place {
  id              String    @id @default(uuid(7)) @db.Uuid
  kind            PlaceKind
  ownerId         String?   @map("owner_id") @db.Uuid
  customName      String?   @map("custom_name")
  customLatitude  Decimal?  @map("custom_latitude") @db.Decimal(9, 6)
  customLongitude Decimal?  @map("custom_longitude") @db.Decimal(9, 6)
  customTimeZone  String?   @map("custom_time_zone")
  customNote      String?   @map("custom_note") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                    Profile?           @relation("PlaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  homeForProfiles          Profile[]          @relation("ProfileHomePlace")
  providerRefs             PlaceProviderRef[]
  savedPlaces              SavedPlace[]
  tripPlaces               TripPlace[]
  tripDestinations         TripDestination[]
  startingLocationForTrips Trip[]             @relation("TripStartingPlace")
  timeZoneSourceForTrips   Trip[]             @relation("TripTimeZoneSourcePlace")

  @@index([ownerId])
  @@map("places")
  @@schema("trove")
}

model PlaceProviderRef {
  id              String        @id @default(uuid(7)) @db.Uuid
  placeId         String        @map("place_id") @db.Uuid
  provider        PlaceProvider
  externalPlaceId String        @map("external_place_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([provider, externalPlaceId])
  @@index([placeId])
  @@map("place_provider_refs")
  @@schema("trove")
}

model Trip {
  id                             String                @id @default(uuid(7)) @db.Uuid
  ownerId                        String                @map("owner_id") @db.Uuid
  creatorId                      String?               @map("creator_id") @db.Uuid
  name                           String
  startDate                      DateTime              @map("start_date") @db.Date
  endDate                        DateTime              @map("end_date") @db.Date
  partySize                      Int                   @default(1) @map("party_size")
  startingPlaceId                String?               @map("starting_place_id") @db.Uuid
  notes                          String?               @db.Text
  coverPhotoPath                 String?               @map("cover_photo_path")
  planningReadiness              TripPlanningReadiness @default(IN_PROGRESS) @map("planning_readiness")
  budgetAmount                   Decimal?              @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrencyCode             String?               @map("budget_currency_code") @db.Char(3)
  visibility                     TripVisibility        @default(PRIVATE)
  referenceTimeZone              String                @map("reference_time_zone")
  referenceTimeZoneSource        TripTimeZoneSource    @map("reference_time_zone_source")
  referenceTimeZoneSourcePlaceId String?               @map("reference_time_zone_source_place_id") @db.Uuid
  referenceTimeZoneResolvedAt    DateTime              @default(now()) @map("reference_time_zone_resolved_at") @db.Timestamptz(3)
  sourceTripId                   String?               @map("source_trip_id") @db.Uuid
  sourceAttribution              String?               @map("source_attribution") @db.Text
  storyCoverMemoryPhotoId        String?               @map("story_cover_memory_photo_id") @db.Uuid
  experienceRating               Int?                  @map("experience_rating")
  experienceNote                 String?               @map("experience_note") @db.Text
  createdAt                      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                        Profile                      @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  creator                      Profile?                     @relation("TripCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  startingPlace                Place?                       @relation("TripStartingPlace", fields: [startingPlaceId], references: [id], onDelete: SetNull)
  referenceTimeZoneSourcePlace Place?                       @relation("TripTimeZoneSourcePlace", fields: [referenceTimeZoneSourcePlaceId], references: [id], onDelete: SetNull)
  sourceTrip                   Trip?                        @relation("TripSource", fields: [sourceTripId], references: [id], onDelete: SetNull)
  derivedTrips                 Trip[]                       @relation("TripSource")
  storyCoverPhoto              MemoryPhoto?                 @relation("TripStoryCoverPhoto", fields: [storyCoverMemoryPhotoId], references: [id], onDelete: SetNull)
  destinations                 TripDestination[]
  userRelationships            TripUserRelationship[]
  tripPlaces                   TripPlace[]
  itineraryDays                ItineraryDay[]
  itineraryItems               ItineraryItem[]
  tasks                        Task[]
  tripInfoEntries              TripInfo[]
  reservations                 Reservation[]
  expenses                     Expense[]
  notifications                Notification[]
  notificationPreferences      TripNotificationPreference[]
  memories                     Memory[]

  @@unique([id, ownerId])
  @@index([ownerId])
  @@index([creatorId])
  @@index([startingPlaceId])
  @@index([referenceTimeZoneSourcePlaceId])
  @@index([sourceTripId])
  @@index([storyCoverMemoryPhotoId])
  @@map("trips")
  @@schema("trove")
}

model TripNotificationPreference {
  ownerId   String   @map("owner_id") @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  muted     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  trip  Trip    @relation(fields: [tripId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([ownerId, tripId])
  @@index([tripId, ownerId])
  @@map("trip_notification_preferences")
  @@schema("trove")
}

model Notification {
  id                 String           @id @default(uuid(7)) @db.Uuid
  ownerId            String           @map("owner_id") @db.Uuid
  tripId             String           @map("trip_id") @db.Uuid
  kind               NotificationKind
  sourceId           String           @map("source_id") @db.Uuid
  sourceVersion      String           @map("source_version")
  eventAt            DateTime         @map("event_at") @db.Timestamptz(3)
  timeZone           String           @map("time_zone")
  readAt             DateTime?        @map("read_at") @db.Timestamptz(3)
  browserDeliveredAt DateTime?        @map("browser_delivered_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  trip  Trip    @relation(fields: [tripId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([ownerId, kind, sourceId])
  @@index([ownerId, readAt, eventAt])
  @@index([tripId, eventAt])
  @@map("notifications")
  @@schema("trove")
}

model TripDestination {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tripId             String    @map("trip_id") @db.Uuid
  placeId            String    @map("place_id") @db.Uuid
  position           Int
  timeZone           String?   @map("time_zone")
  timeZoneResolvedAt DateTime? @map("time_zone_resolved_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Restrict)

  @@unique([tripId, position])
  @@unique([tripId, placeId])
  @@index([placeId])
  @@map("trip_destinations")
  @@schema("trove")
}

model TripUserRelationship {
  tripId    String       @map("trip_id") @db.Uuid
  profileId String       @map("profile_id") @db.Uuid
  role      TripUserRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([tripId, profileId])
  @@index([profileId, role])
  @@map("trip_user_relationships")
  @@schema("trove")
}

model SavedPlace {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  placeId   String   @map("place_id") @db.Uuid
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner           Profile                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  place           Place                  @relation(fields: [placeId], references: [id], onDelete: Restrict)
  collectionLinks SavedCollectionPlace[]

  @@unique([ownerId, placeId])
  @@unique([id, ownerId])
  @@index([placeId])
  @@map("saved_places")
  @@schema("trove")
}

model SavedCollection {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner  Profile                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  places SavedCollectionPlace[]

  @@unique([ownerId, name])
  @@unique([id, ownerId])
  @@index([ownerId])
  @@map("saved_collections")
  @@schema("trove")
}

model SavedCollectionPlace {
  ownerId      String   @map("owner_id") @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  savedPlaceId String   @map("saved_place_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  owner      Profile         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collection SavedCollection @relation(fields: [collectionId, ownerId], references: [id, ownerId], onDelete: Cascade)
  savedPlace SavedPlace      @relation(fields: [savedPlaceId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@id([collectionId, savedPlaceId])
  @@index([ownerId])
  @@index([savedPlaceId, ownerId])
  @@map("saved_collection_places")
  @@schema("trove")
}

model TripPlace {
  id        String             @id @default(uuid(7)) @db.Uuid
  tripId    String             @map("trip_id") @db.Uuid
  placeId   String             @map("place_id") @db.Uuid
  priority  TripPlacePriority?
  note      String?            @db.Text
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip                  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place                 Place           @relation(fields: [placeId], references: [id], onDelete: Restrict)
  itineraryItems        ItineraryItem[]
  dailyBaseForDays      ItineraryDay[]  @relation("ItineraryDayDailyBase")
  timeZoneSourceForDays ItineraryDay[]  @relation("ItineraryDayTimeZoneSource")
  reservations          Reservation[]
  expenses              Expense[]
  memories              Memory[]

  @@unique([tripId, placeId])
  @@unique([id, tripId])
  @@index([placeId])
  @@map("trip_places")
  @@schema("trove")
}

model ItineraryDay {
  id                               String            @id @default(uuid(7)) @db.Uuid
  tripId                           String            @map("trip_id") @db.Uuid
  date                             DateTime          @db.Date
  dailyBaseTripPlaceId             String?           @map("daily_base_trip_place_id") @db.Uuid
  notes                            String?           @db.Text
  experienceRating                 Int?              @map("experience_rating")
  experienceNote                   String?           @map("experience_note") @db.Text
  routeStartTravelMode             RouteTravelMode   @default(DRIVE) @map("route_start_travel_mode")
  defaultTimeZone                  String            @map("default_time_zone")
  defaultTimeZoneSource            DayTimeZoneSource @map("default_time_zone_source")
  defaultTimeZoneSourceTripPlaceId String?           @map("default_time_zone_source_trip_place_id") @db.Uuid
  defaultTimeZoneSourceItemId      String?           @map("default_time_zone_source_item_id") @db.Uuid
  defaultTimeZoneResolvedAt        DateTime          @default(now()) @map("default_time_zone_resolved_at") @db.Timestamptz(3)
  createdAt                        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip                      Trip                          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dailyBaseTripPlace        TripPlace?                    @relation("ItineraryDayDailyBase", fields: [dailyBaseTripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)
  timeZoneSourceTripPlace   TripPlace?                    @relation("ItineraryDayTimeZoneSource", fields: [defaultTimeZoneSourceTripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)
  timeZoneSourceItem        ItineraryItem?                @relation("ItineraryDayTimeZoneSourceItem", fields: [defaultTimeZoneSourceItemId, tripId], references: [id, tripId], onDelete: NoAction)
  items                     ItineraryItem[]               @relation("ItineraryDayItems")
  memories                  Memory[]
  tasks                     Task[]                        @relation("TaskItineraryDay")
  expenses                  Expense[]                     @relation("ExpenseItineraryDay")
  accommodationReservations ReservationAccommodationDay[]

  @@unique([tripId, date])
  @@unique([id, tripId])
  @@index([dailyBaseTripPlaceId, tripId])
  @@index([defaultTimeZoneSourceTripPlaceId, tripId])
  @@index([defaultTimeZoneSourceItemId, tripId])
  @@map("itinerary_days")
  @@schema("trove")
}

model ItineraryItem {
  id                      String                  @id @default(uuid(7)) @db.Uuid
  tripId                  String                  @map("trip_id") @db.Uuid
  itineraryDayId          String?                 @map("itinerary_day_id") @db.Uuid
  tripPlaceId             String?                 @map("trip_place_id") @db.Uuid
  customLabel             String?                 @map("custom_label")
  customLocation          String?                 @map("custom_location")
  customLocationTimeZone  String?                 @map("custom_location_time_zone")
  position                Int
  travelModeToNext        RouteTravelMode         @default(DRIVE) @map("travel_mode_to_next")
  travelStatus            ItineraryTravelStatus   @default(UPCOMING) @map("travel_status")
  localStartTime          DateTime?               @map("local_start_time") @db.Time(0)
  startInstant            DateTime?               @map("start_instant") @db.Timestamptz(3)
  timeSemantics           ItineraryTimeSemantics? @map("time_semantics")
  timeZone                String?                 @map("time_zone")
  timeZoneSource          ItemTimeZoneSource?     @map("time_zone_source")
  timeZoneResolvedAt      DateTime?               @map("time_zone_resolved_at") @db.Timestamptz(3)
  dayPart                 ItineraryDayPart?       @map("day_part")
  durationMinutes         Int?                    @map("duration_minutes")
  notes                   String?                 @db.Text
  priority                TripPlacePriority?
  plannedCostAmount       Decimal?                @map("planned_cost_amount") @db.Decimal(12, 2)
  plannedCostCurrencyCode String?                 @map("planned_cost_currency_code") @db.Char(3)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip                  Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryDay          ItineraryDay?  @relation("ItineraryDayItems", fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: NoAction)
  tripPlace             TripPlace?     @relation(fields: [tripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)
  timeZoneSourceForDays ItineraryDay[] @relation("ItineraryDayTimeZoneSourceItem")
  memories              Memory[]
  tasks                 Task[]         @relation("TaskItineraryItem")
  reservations          Reservation[]
  expenses              Expense[]      @relation("ExpenseItineraryItem")

  @@unique([id, tripId])
  @@index([tripId])
  @@index([itineraryDayId, tripId])
  @@index([tripPlaceId, tripId])
  @@map("itinerary_items")
  @@schema("trove")
}

model Task {
  id                    String              @id @default(uuid(7)) @db.Uuid
  tripId                String              @map("trip_id") @db.Uuid
  itineraryDayId        String?             @map("itinerary_day_id") @db.Uuid
  itineraryItemId       String?             @map("itinerary_item_id") @db.Uuid
  label                 String
  note                  String?             @db.Text
  dueDate               DateTime?           @map("due_date") @db.Date
  dueLocalTime          DateTime?           @map("due_local_time") @db.Time(0)
  dueTimeZone           String?             @map("due_time_zone")
  dueTimeZoneSource     TaskTimeZoneSource? @map("due_time_zone_source")
  dueTimeZoneResolvedAt DateTime?           @map("due_time_zone_resolved_at") @db.Timestamptz(3)
  completedAt           DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryDay  ItineraryDay?  @relation("TaskItineraryDay", fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: NoAction)
  itineraryItem ItineraryItem? @relation("TaskItineraryItem", fields: [itineraryItemId, tripId], references: [id, tripId], onDelete: NoAction)

  @@index([tripId, completedAt])
  @@index([itineraryDayId, tripId])
  @@index([itineraryItemId, tripId])
  @@map("tasks")
  @@schema("trove")
}

model TaskTemplate {
  id        String   @id @default(uuid(7)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items TaskTemplateItem[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("task_templates")
  @@schema("trove")
}

model TaskTemplateItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  taskTemplateId String   @map("task_template_id") @db.Uuid
  position       Int
  label          String
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taskTemplate TaskTemplate @relation(fields: [taskTemplateId], references: [id], onDelete: Cascade)

  @@unique([taskTemplateId, position])
  @@index([taskTemplateId])
  @@map("task_template_items")
  @@schema("trove")
}

model TripInfo {
  id        String   @id @default(uuid(7)) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  label     String
  value     String   @db.Text
  category  String?
  note      String?  @db.Text
  link      String?  @db.Text
  isPinned  Boolean  @default(false) @map("is_pinned")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, isPinned, updatedAt])
  @@map("trip_info")
  @@schema("trove")
}

model Reservation {
  id                       String                     @id @default(uuid(7)) @db.Uuid
  tripId                   String                     @map("trip_id") @db.Uuid
  tripPlaceId              String?                    @map("trip_place_id") @db.Uuid
  itineraryItemId          String?                    @map("itinerary_item_id") @db.Uuid
  title                    String
  type                     ReservationType?
  provider                 String?
  bookingReference         String?                    @map("booking_reference")
  notes                    String?                    @db.Text
  localDate                DateTime?                  @map("local_date") @db.Date
  localTime                DateTime?                  @map("local_time") @db.Time(0)
  timeZone                 String?                    @map("time_zone")
  timeZoneSource           ReservationTimeZoneSource? @map("time_zone_source")
  timeZoneResolvedAt       DateTime?                  @map("time_zone_resolved_at") @db.Timestamptz(3)
  plannedCostAmount        Decimal?                   @map("planned_cost_amount") @db.Decimal(12, 2)
  plannedCostCurrencyCode  String?                    @map("planned_cost_currency_code") @db.Char(3)
  checkInDate              DateTime?                  @map("check_in_date") @db.Date
  checkOutDate             DateTime?                  @map("check_out_date") @db.Date
  accommodationAddress     String?                    @map("accommodation_address") @db.Text
  flightAirline            String?                    @map("flight_airline")
  flightNumber             String?                    @map("flight_number")
  flightDepartureAirport   String?                    @map("flight_departure_airport")
  flightDepartureLocalDate DateTime?                  @map("flight_departure_local_date") @db.Date
  flightDepartureLocalTime DateTime?                  @map("flight_departure_local_time") @db.Time(0)
  flightDepartureTimeZone  String?                    @map("flight_departure_time_zone")
  flightDepartureInstant   DateTime?                  @map("flight_departure_instant") @db.Timestamptz(3)
  flightArrivalAirport     String?                    @map("flight_arrival_airport")
  flightArrivalLocalDate   DateTime?                  @map("flight_arrival_local_date") @db.Date
  flightArrivalLocalTime   DateTime?                  @map("flight_arrival_local_time") @db.Time(0)
  flightArrivalTimeZone    String?                    @map("flight_arrival_time_zone")
  flightArrivalInstant     DateTime?                  @map("flight_arrival_instant") @db.Timestamptz(3)
  flightTerminal           String?                    @map("flight_terminal")
  flightGate               String?                    @map("flight_gate")
  flightSeat               String?                    @map("flight_seat")
  transportOperator        String?                    @map("transport_operator")
  transportServiceNumber   String?                    @map("transport_service_number")
  transportPickupLocation  String?                    @map("transport_pickup_location")
  transportDropoffLocation String?                    @map("transport_dropoff_location")
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip              Trip                          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripPlace         TripPlace?                    @relation(fields: [tripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)
  itineraryItem     ItineraryItem?                @relation(fields: [itineraryItemId, tripId], references: [id, tripId], onDelete: NoAction)
  attachments       ReservationAttachment[]
  accommodationDays ReservationAccommodationDay[]

  @@unique([id, tripId])
  @@index([tripId, localDate])
  @@index([tripId, flightDepartureLocalDate])
  @@index([tripPlaceId, tripId])
  @@index([itineraryItemId, tripId])
  @@map("reservations")
  @@schema("trove")
}

model ReservationAttachment {
  id            String   @id @default(uuid(7)) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  path          String
  fileName      String   @map("file_name")
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, path])
  @@index([reservationId])
  @@map("reservation_attachments")
  @@schema("trove")
}

model ReservationAccommodationDay {
  reservationId  String   @map("reservation_id") @db.Uuid
  itineraryDayId String   @map("itinerary_day_id") @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation  Reservation  @relation(fields: [reservationId, tripId], references: [id, tripId], onDelete: Cascade)
  itineraryDay ItineraryDay @relation(fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: Cascade)

  @@id([reservationId, itineraryDayId])
  @@index([itineraryDayId, tripId])
  @@map("reservation_accommodation_days")
  @@schema("trove")
}

model Expense {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  tripId             String                 @map("trip_id") @db.Uuid
  itineraryDayId     String?                @map("itinerary_day_id") @db.Uuid
  itineraryItemId    String?                @map("itinerary_item_id") @db.Uuid
  tripPlaceId        String?                @map("trip_place_id") @db.Uuid
  amount             Decimal                @db.Decimal(12, 2)
  currencyCode       String                 @map("currency_code") @db.Char(3)
  title              String?
  category           ExpenseCategory?
  localDate          DateTime?              @map("local_date") @db.Date
  localTime          DateTime?              @map("local_time") @db.Time(0)
  timeZone           String?                @map("time_zone")
  timeZoneSource     ExpenseTimeZoneSource? @map("time_zone_source")
  timeZoneResolvedAt DateTime?              @map("time_zone_resolved_at") @db.Timestamptz(3)
  note               String?                @db.Text
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryDay  ItineraryDay?  @relation("ExpenseItineraryDay", fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: NoAction)
  itineraryItem ItineraryItem? @relation("ExpenseItineraryItem", fields: [itineraryItemId, tripId], references: [id, tripId], onDelete: NoAction)
  tripPlace     TripPlace?     @relation(fields: [tripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)

  @@unique([id, tripId])
  @@index([tripId, localDate])
  @@index([itineraryDayId, tripId])
  @@index([itineraryItemId, tripId])
  @@index([tripPlaceId, tripId])
  @@map("expenses")
  @@schema("trove")
}

model Memory {
  id                 String               @id @default(uuid(7)) @db.Uuid
  tripId             String               @map("trip_id") @db.Uuid
  itineraryDayId     String?              @map("itinerary_day_id") @db.Uuid
  itineraryItemId    String?              @map("itinerary_item_id") @db.Uuid
  tripPlaceId        String?              @map("trip_place_id") @db.Uuid
  note               String?              @db.Text
  isHighlight        Boolean              @default(false) @map("is_highlight")
  highlightPosition  Int?                 @map("highlight_position")
  capturedInstant    DateTime             @map("captured_instant") @db.Timestamptz(3)
  capturedLocalDate  DateTime             @map("captured_local_date") @db.Date
  capturedLocalTime  DateTime             @map("captured_local_time") @db.Time(0)
  timeZone           String               @map("time_zone")
  timeZoneSource     MemoryTimeZoneSource @map("time_zone_source")
  timeZoneResolvedAt DateTime             @default(now()) @map("time_zone_resolved_at") @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  itineraryDay  ItineraryDay?  @relation(fields: [itineraryDayId, tripId], references: [id, tripId], onDelete: NoAction)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId, tripId], references: [id, tripId], onDelete: NoAction)
  tripPlace     TripPlace?     @relation(fields: [tripPlaceId, tripId], references: [id, tripId], onDelete: NoAction)
  photos        MemoryPhoto[]

  @@unique([id, tripId])
  @@index([tripId, capturedInstant])
  @@index([tripId, isHighlight, highlightPosition])
  @@index([itineraryDayId, tripId])
  @@index([itineraryItemId, tripId])
  @@index([tripPlaceId, tripId])
  @@map("memories")
  @@schema("trove")
}

model MemoryPhoto {
  id          String   @id @default(uuid(7)) @db.Uuid
  memoryId    String   @map("memory_id") @db.Uuid
  path        String
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memory             Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  storyCoverForTrips Trip[] @relation("TripStoryCoverPhoto")

  @@unique([memoryId, path])
  @@index([memoryId, position])
  @@map("memory_photos")
  @@schema("trove")
}
