enum ProfileAppearance {
  LIGHT @map("light")
  DARK  @map("dark")

  @@map("profile_appearance")
  @@schema("trove")
}

enum NotificationKind {
  TASK_DUE             @map("task_due")
  RESERVATION_UPCOMING @map("reservation_upcoming")
  LEAVE_BY             @map("leave_by")

  @@map("notification_kind")
  @@schema("trove")
}

/// Supabase owns this table. Prisma Client may reference its primary key, but
/// Prisma Migrate excludes it through `tables.external` in prisma.config.ts.
model AuthUser {
  id      String   @id @db.Uuid
  profile Profile?

  @@map("users")
  @@schema("auth")
}

model Profile {
  id                          String                  @id @db.Uuid
  displayName                 String?                 @map("display_name")
  avatarPath                  String?                 @map("avatar_path")
  homePlaceId                 String?                 @map("home_place_id") @db.Uuid
  homeCurrencyCode            String?                 @map("home_currency_code") @db.Char(3)
  distanceUnit                ProfileDistanceUnit?    @map("distance_unit")
  temperatureUnit             ProfileTemperatureUnit? @map("temperature_unit")
  timeFormat                  ProfileTimeFormat?      @map("time_format")
  dateFormat                  ProfileDateFormat?      @map("date_format")
  appearance                  ProfileAppearance?      @map("appearance")
  notificationsEnabled        Boolean                 @default(false) @map("notifications_enabled")
  browserNotificationsEnabled Boolean                 @default(false) @map("browser_notifications_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  authUser                    AuthUser                     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  homePlace                   Place?                       @relation("ProfileHomePlace", fields: [homePlaceId], references: [id], onDelete: SetNull)
  ownedPlaces                 Place[]                      @relation("PlaceOwner")
  ownedTrips                  Trip[]                       @relation("TripOwner")
  createdTrips                Trip[]                       @relation("TripCreator")
  tripRelations               TripUserRelationship[]
  savedPlaces                 SavedPlace[]
  savedCollections            SavedCollection[]
  collectionPlaces            SavedCollectionPlace[]
  taskTemplates               TaskTemplate[]
  notifications               Notification[]
  tripNotificationPreferences TripNotificationPreference[]
  aiPlanningSessions          AiPlanningSession[]
  aiGenerationRuns            AiGenerationRun[]

  @@index([homePlaceId])
  @@map("profiles")
  @@schema("trove")
}

model Place {
  id                  String    @id @default(uuid(7)) @db.Uuid
  kind                PlaceKind
  ownerId             String?   @map("owner_id") @db.Uuid
  customName          String?   @map("custom_name")
  customLatitude      Decimal?  @map("custom_latitude") @db.Decimal(9, 6)
  customLongitude     Decimal?  @map("custom_longitude") @db.Decimal(9, 6)
  customTimeZone      String?   @map("custom_time_zone")
  customNote          String?   @map("custom_note") @db.Text
  /// The name and address the provider gave when this Place was first resolved.
  /// A last-resort label so a Place is never nameless; live details always win.
  providerLabel       String?   @map("provider_label") @db.Text
  providerAddress     String?   @map("provider_address") @db.Text
  /// The editorial collection representing this Place. Decorative only, and
  /// unrelated to the provider data above.
  editorialImageSetId String?   @map("editorial_image_set_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner                    Profile?           @relation("PlaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  editorialImageSet        EditorialImageSet? @relation("PlaceEditorialImageSet", fields: [editorialImageSetId], references: [id], onDelete: SetNull)
  homeForProfiles          Profile[]          @relation("ProfileHomePlace")
  providerRefs             PlaceProviderRef[]
  savedPlaces              SavedPlace[]
  tripPlaces               TripPlace[]
  tripDestinations         TripDestination[]
  startingLocationForTrips Trip[]             @relation("TripStartingPlace")
  timeZoneSourceForTrips   Trip[]             @relation("TripTimeZoneSourcePlace")

  @@index([editorialImageSetId])
  @@index([ownerId])
  @@map("places")
  @@schema("trove")
}

model PlaceProviderRef {
  id              String        @id @default(uuid(7)) @db.Uuid
  placeId         String        @map("place_id") @db.Uuid
  provider        PlaceProvider
  externalPlaceId String        @map("external_place_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// A snapshot of the provider's *durable* answer for this reference: what the
  /// place is called, where it is, and what kind of thing it is. None of it is
  /// canonical Trove truth (PRD 11.4) — `cachedAt` dates it and it is refetched
  /// once stale, which is what PRD 11.7 means by retaining freshness context.
  ///
  /// Mutable detail — rating, review count, opening hours, website, phone,
  /// photos — is deliberately absent and always fetched live. Caching it is
  /// what the policy actually prohibits, and it is also the half that goes out
  /// of date in ways a traveller would act on.
  ///
  /// Without this, every rendered place name and every routed leg costs a Place
  /// Details call, because a provider Place otherwise stores no name and no
  /// coordinates at all.
  cachedName             String?   @map("cached_name") @db.Text
  cachedFormattedAddress String?   @map("cached_formatted_address") @db.Text
  cachedLatitude         Decimal?  @map("cached_latitude") @db.Decimal(9, 6)
  cachedLongitude        Decimal?  @map("cached_longitude") @db.Decimal(9, 6)
  cachedPrimaryType      String?   @map("cached_primary_type")
  cachedTypes            String[]  @default([]) @map("cached_types")
  cachedGoogleMapsUri    String?   @map("cached_google_maps_uri") @db.Text
  cachedUtcOffsetMinutes Int?      @map("cached_utc_offset_minutes")
  /// The language the snapshot was fetched in. A name is language-specific, so
  /// a snapshot may only answer a request asking for the same language.
  cachedLanguageCode     String?   @map("cached_language_code")
  cachedAt               DateTime? @map("cached_at") @db.Timestamptz(3)
  detailsFailureCode     String?   @map("details_failure_code")
  detailsFailedAt        DateTime? @map("details_failed_at") @db.Timestamptz(3)

  place          Place                   @relation(fields: [placeId], references: [id], onDelete: Cascade)
  groundingCache AiPlaceGroundingCache[]

  @@unique([provider, externalPlaceId])
  @@index([placeId])
  @@map("place_provider_refs")
  @@schema("trove")
}

/// A grounding decision for a versioned hash of the query and matching inputs.
/// Only identity and Trove lookup metadata are stored, never provider content.
/// Both successful and negative decisions expire 30 days after checkedAt.
model AiPlaceGroundingCache {
  key                String   @id @db.VarChar(64)
  outcome            String
  checkedAt          DateTime @map("checked_at") @db.Timestamptz(3)
  placeProviderRefId String?  @map("place_provider_ref_id") @db.Uuid

  placeProviderRef PlaceProviderRef? @relation(fields: [placeProviderRefId], references: [id], onDelete: Cascade)

  @@index([placeProviderRefId])
  @@map("ai_place_grounding_cache")
  @@schema("trove")
}

/// A provider's travel estimate for one origin/destination/mode triple.
///
/// Trove asks for routes without a departure time, so an estimate does not
/// depend on when it was requested and the same leg re-answers identically
/// until the road network changes. Re-asking per request made a day's itinerary
/// cost one Routes call per leg every time it was opened.
///
/// Coordinates are the key rather than Place ids because a leg may start or end
/// at a Custom Place that has no provider reference.
model TravelLegCache {
  id                   String          @id @default(uuid(7)) @db.Uuid
  originLatitude       Decimal         @map("origin_latitude") @db.Decimal(9, 6)
  originLongitude      Decimal         @map("origin_longitude") @db.Decimal(9, 6)
  destinationLatitude  Decimal         @map("destination_latitude") @db.Decimal(9, 6)
  destinationLongitude Decimal         @map("destination_longitude") @db.Decimal(9, 6)
  mode                 RouteTravelMode
  distanceMeters       Int             @map("distance_meters")
  durationSeconds      Int             @map("duration_seconds")
  encodedPolyline      String?         @map("encoded_polyline") @db.Text
  fetchedAt            DateTime        @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@unique([originLatitude, originLongitude, destinationLatitude, destinationLongitude, mode], name: "travel_leg_cache_leg")
  @@index([fetchedAt])
  @@map("travel_leg_cache")
  @@schema("trove")
}

/// One coordinate's daily forecast, so a trip's day-by-day weather costs one
/// provider call rather than one per day, per screen, per traveller.
///
/// Coordinates are the key, and they are rounded before they are written for
/// the same reason `TravelLegCache` rounds: a key that cannot be read back by
/// the value that wrote it is not a cache. Rounding also makes two stops in the
/// same city share one snapshot, which is the whole saving on a dense day.
///
/// Temperatures are stored in celsius alone and converted on read, so a
/// traveller's unit preference never doubles the number of rows the provider
/// has to fill.
model WeatherForecastSnapshot {
  id        String   @id @default(uuid(7)) @db.Uuid
  provider  String   @default("open_meteo")
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  timeZone  String   @map("time_zone")
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  days WeatherForecastSnapshotDay[]

  @@unique([provider, latitude, longitude], name: "weather_forecast_snapshot_point")
  @@index([fetchedAt])
  @@map("weather_forecast_snapshots")
  @@schema("trove")
}

/// One dated day inside a forecast snapshot.
///
/// A snapshot holds the provider's whole available window rather than the slice
/// one trip asked for, so two trips passing through the same city share an
/// answer instead of overwriting each other's narrower range.
model WeatherForecastSnapshotDay {
  snapshotId               String   @map("snapshot_id") @db.Uuid
  date                     DateTime @db.Date
  weatherCode              Int      @map("weather_code")
  temperatureMaxCelsius    Decimal  @map("temperature_max_celsius") @db.Decimal(5, 2)
  temperatureMinCelsius    Decimal  @map("temperature_min_celsius") @db.Decimal(5, 2)
  precipitationProbability Int?     @map("precipitation_probability")

  snapshot WeatherForecastSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, date])
  @@map("weather_forecast_snapshot_days")
  @@schema("trove")
}

/// One day's exchange rates from Frankfurter, always expressed against EUR.
///
/// Frankfurter republishes once per working day, so asking it per conversion
/// was a provider call inside a user-driven loop: every keystroke on the
/// converter, and every expense rendered in the home currency, paid for an
/// answer that had not changed since the morning.
///
/// The whole board is stored rather than the pair that was asked for, because
/// `/v2/rates` returns every quote for the price of one request. A pair Trove
/// has never seen is then arithmetic — `rates[quote] / rates[base]` — instead
/// of a new call, which is what keeps the cost flat as people pick currencies.
model CurrencyRateSnapshot {
  id        String                     @id @default(uuid(7)) @db.Uuid
  provider  String                     @default("frankfurter")
  base      String                     @db.Char(3)
  rateDate  DateTime                   @map("rate_date") @db.Date
  fetchedAt DateTime                   @default(now()) @map("fetched_at") @db.Timestamptz(3)
  rates     CurrencyRateSnapshotRate[]

  @@unique([provider, base, rateDate], name: "currency_rate_snapshot_day")
  @@index([fetchedAt])
  @@map("currency_rate_snapshots")
  @@schema("trove")
}

/// One quote currency's rate inside a snapshot, with its own publication date.
model CurrencyRateSnapshotRate {
  snapshotId String   @map("snapshot_id") @db.Uuid
  code       String   @db.Char(3)
  rate       Decimal  @db.Decimal(20, 10)
  /// The reference does not move every currency on the same day, so a quote
  /// carries the date it was actually published rather than the board's.
  rateDate   DateTime @map("rate_date") @db.Date

  snapshot CurrencyRateSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, code])
  @@map("currency_rate_snapshot_rates")
  @@schema("trove")
}

/// Frankfurter's currency list, refreshed on the same daily cadence as rates.
///
/// Names and symbols are reference data rather than provider truth about a
/// place, so a shared copy is safe to keep and cheap to serve.
model CurrencyMetadataEntry {
  code      String   @id @db.Char(3)
  name      String
  symbol    String?
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@map("currency_metadata")
  @@schema("trove")
}

/// One editorial subject cache, containing an ordered collection of photographs.
///
/// Editorial imagery is Trove's second, deliberately separate media track: it is
/// decorative, free, hotlinked, and always attributed. It is not provider data
/// about a place, and it never comes from Google Places photos, which stay
/// forbidden as a decorative source (PRD 11.5).
///
/// `subjectKey` is the normalised resolution key for a destination or Place.
/// Once it has an answer, every session and user receives the same ordered
/// collection until `cachedAt` becomes stale.
///
/// Each child stores one unsized source URL plus its metadata. Image bytes are
/// never stored; Supabase Storage stays user-uploaded media only.
///
/// A subject the provider cannot answer is recorded on the same row through
/// `missCode`/`missedAt`, mirroring PlaceProviderRef's failure columns, so an
/// empty answer is negatively cached rather than re-asked on every render.
model EditorialImageSet {
  id                String   @id @default(uuid(7)) @db.Uuid
  subjectKey        String   @unique @map("subject_key")
  resolutionVersion Int      @default(1) @map("resolution_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cachedAt DateTime? @map("cached_at") @db.Timestamptz(3)
  missCode String?   @map("miss_code")
  missedAt DateTime? @map("missed_at") @db.Timestamptz(3)

  images                  EditorialImage[]
  editorialCoverForTrips  Trip[]           @relation("TripEditorialImageSet")
  editorialImageForPlaces Place[]          @relation("PlaceEditorialImageSet")

  @@index([cachedAt])
  @@index([resolutionVersion, cachedAt])
  @@map("editorial_image_sets")
  @@schema("trove")
}

/// One photograph in an editorial subject's deterministic collection.
model EditorialImage {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  editorialImageSetId String                 @map("editorial_image_set_id") @db.Uuid
  position            Int
  provider            EditorialImageProvider
  externalPhotoId     String                 @map("external_photo_id")
  providerPageUrl     String                 @map("provider_page_url") @db.Text
  photographerName    String                 @map("photographer_name") @db.Text
  photographerUrl     String                 @map("photographer_url") @db.Text
  sourceUrl           String                 @map("source_url") @db.Text
  width               Int?
  height              Int?
  dominantColor       String?                @map("dominant_color")
  altText             String?                @map("alt_text") @db.Text
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  editorialImageSet EditorialImageSet @relation(fields: [editorialImageSetId], references: [id], onDelete: Cascade)

  @@unique([editorialImageSetId, position])
  @@unique([editorialImageSetId, provider, externalPhotoId])
  @@index([editorialImageSetId])
  @@map("editorial_images")
  @@schema("trove")
}

model Trip {
  id                             String                @id @default(uuid(7)) @db.Uuid
  ownerId                        String                @map("owner_id") @db.Uuid
  creatorId                      String?               @map("creator_id") @db.Uuid
  name                           String
  /// The traveller's own framing of the trip. Prose, not a planning scratchpad.
  description                    String?               @db.Text
  startDate                      DateTime              @map("start_date") @db.Date
  endDate                        DateTime              @map("end_date") @db.Date
  partySize                      Int                   @default(1) @map("party_size")
  startingPlaceId                String?               @map("starting_place_id") @db.Uuid
  coverPhotoPath                 String?               @map("cover_photo_path")
  /// The editorial collection standing in for this trip's destination. Separate
  /// from `coverPhotoPath`, which is the traveller's own uploaded cover and
  /// always wins over it.
  editorialImageSetId            String?               @map("editorial_image_set_id") @db.Uuid
  planningReadiness              TripPlanningReadiness @default(IN_PROGRESS) @map("planning_readiness")
  /// Last computed Plan Score, kept only as a cache. `planScoreRevision` is a
  /// digest of every Trove-owned input the rubric reads, so an itinerary edit
  /// invalidates it without a trigger; `planScoreComputedAt` bounds how stale
  /// the provider evidence behind it may be, which no revision can express.
  planScore                      Json?                 @map("plan_score") @db.JsonB
  planScoreRevision              String?               @map("plan_score_revision") @db.VarChar(64)
  planScoreComputedAt            DateTime?             @map("plan_score_computed_at") @db.Timestamptz(3)
  budgetAmount                   Decimal?              @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrencyCode             String?               @map("budget_currency_code") @db.Char(3)
  visibility                     TripVisibility        @default(PRIVATE)
  referenceTimeZone              String                @map("reference_time_zone")
  referenceTimeZoneSource        TripTimeZoneSource    @map("reference_time_zone_source")
  referenceTimeZoneSourcePlaceId String?               @map("reference_time_zone_source_place_id") @db.Uuid
  referenceTimeZoneResolvedAt    DateTime              @default(now()) @map("reference_time_zone_resolved_at") @db.Timestamptz(3)
  sourceTripId                   String?               @map("source_trip_id") @db.Uuid
  sourceAttribution              String?               @map("source_attribution") @db.Text
  storyCoverMemoryPhotoId        String?               @map("story_cover_memory_photo_id") @db.Uuid
  experienceRating               Int?                  @map("experience_rating")
  experienceNote                 String?               @map("experience_note") @db.Text
  createdAt                      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
