generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "trove"]
}

enum PlaceKind {
  PROVIDER @map("provider")
  CUSTOM   @map("custom")

  @@map("place_kind")
  @@schema("trove")
}

enum PlaceProvider {
  GOOGLE @map("google")

  @@map("place_provider")
  @@schema("trove")
}

enum EditorialImageProvider {
  PEXELS @map("pexels")

  @@map("editorial_image_provider")
  @@schema("trove")
}

enum TripPlanningReadiness {
  IN_PROGRESS @map("in_progress")
  READY       @map("ready")

  @@map("trip_planning_readiness")
  @@schema("trove")
}

enum TripVisibility {
  PRIVATE @map("private")
  SHARED  @map("shared")
  PUBLIC  @map("public")

  @@map("trip_visibility")
  @@schema("trove")
}

enum TripUserRole {
  OWNER        @map("owner")
  COLLABORATOR @map("collaborator")
  VIEWER       @map("viewer")

  @@map("trip_user_role")
  @@schema("trove")
}

enum TripTimeZoneSource {
  EXPLICIT          @map("explicit")
  DESTINATION       @map("destination")
  STARTING_LOCATION @map("starting_location")
  PROFILE_HOME      @map("profile_home")
  DEVICE_FALLBACK   @map("device_fallback")

  @@map("trip_time_zone_source")
  @@schema("trove")
}

enum DayTimeZoneSource {
  EXPLICIT_DAILY_BASE @map("explicit_daily_base")
  ACCOMMODATION       @map("accommodation")
  FIRST_LOCATED_ITEM  @map("first_located_item")
  TRIP_REFERENCE      @map("trip_reference")

  @@map("day_time_zone_source")
  @@schema("trove")
}

enum ItemTimeZoneSource {
  EXPLICIT    @map("explicit")
  PLACE       @map("place")
  DAY_DEFAULT @map("day_default")

  @@map("item_time_zone_source")
  @@schema("trove")
}

enum ReservationType {
